<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Предупреждения компилятора — ошибки сборки только в CI (GitHub Actions задаёт CI=true) или по запросу:
         dotnet build PdmLite.sln -p:PdmLiteStrict=true
         Локальная сборка в Visual Studio не останавливается из-за предупреждений: более новый SDK
         может добавить предупреждения, которых не было при проверке в CI. Предупреждения NuGet об
         уязвимостях пакетов (NU1901–NU1904) ошибками не считаются: они появляются без изменений в коде. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true' Or '$(PdmLiteStrict)' == 'true'">true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Company>PdmLite</Company>
    <Product>PdmLite</Product>
    <Version>0.1.0</Version>
    <!-- Позволяет собирать WPF/WinForms-проекты не на Windows (CI, проверка сборки). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
